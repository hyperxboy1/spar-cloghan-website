---
import Icon from './Icon.astro';
import Tbc from './Tbc.astro';
import { business } from '../data/business';
import { hours, describeDays } from '../data/hours';
import { IS_REVIEW } from '../data/site';
---

<section class="visit" id="visit" aria-labelledby="visit-title">
  <div class="visit__inner">
    <div class="visit__main">
      <p class="kicker">Visit us</p>
      <h2 id="visit-title" class="display visit__title">
        Find us on <span>Hill Street.</span>
      </h2>
      <address class="visit__address serif">
        {business.address.street}<br />
        {business.address.town}<br />
        {business.address.county}<br />
        <span class="visit__eircode">{business.address.eircode}</span>
      </address>
      <div class="visit__actions">
        <a class="btn btn--red btn--lg" href={business.directionsUrl} target="_blank" rel="noopener" data-magnetic>
          <span class="btn__inner">
            <Icon name="directions" size={20} />
            Get directions
            <span class="visually-hidden">(opens Google Maps in a new tab)</span>
          </span>
        </a>
        <a class="btn btn--lg" href={business.phone.href} data-magnetic>
          <span class="btn__inner">
            <Icon name="phone" size={20} class="visit__phone-icon" />
            Call the shop
          </span>
        </a>
      </div>
      {IS_REVIEW && !business.directionsVerified && <p class="visit__check"><Tbc status="review" label="Check map pin" /> Directions open a Google Maps search for the shop’s address.</p>}
    </div>

    <ul class="visit__cards" role="list">
      <li class="pop visit-card visit-card--phone">
        <div class="pop__body visit-card__body">
          <Icon name="phone" size={28} class="visit-card__icon" />
          <h3 class="visit-card__title">Phone</h3>
          <a class="visit-card__big display" href={business.phone.href}>{business.phone.display}</a>
          <p class="visit-card__meta">From outside Ireland: {business.phone.international}</p>
        </div>
      </li>

      <li class="pop visit-card visit-card--hours">
        <div class="pop__body visit-card__body">
          <Icon name="clock" size={28} class="visit-card__icon" />
          <h3 class="visit-card__title">Opening hours</h3>
          {
            hours.approved && hours.store.length ? (
              <dl class="visit-card__hours">
                {hours.store.map((row) => (
                  <div>
                    <dt>{describeDays(row.days)}</dt>
                    <dd>
                      {row.opens}–{row.closes}
                    </dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="visit-card__text">
                {hours.fallbackMessage}{' '}
                <a href={business.phone.href}>{business.phone.display}</a>
              </p>
            )
          }
        </div>
      </li>

      <li class="pop visit-card visit-card--eircode">
        <div class="pop__body visit-card__body">
          <Icon name="pin" size={28} class="visit-card__icon" />
          <h3 class="visit-card__title">Eircode for your sat-nav</h3>
          <p class="visit-card__big display">{business.address.eircode}</p>
        </div>
      </li>

      <li class="pop visit-card visit-card--social">
        <div class="pop__body visit-card__body">
          <Icon name="heart" size={28} class="visit-card__icon" />
          <h3 class="visit-card__title">Follow the shop</h3>
          <ul class="visit-card__social" role="list">
            <li>
              <a href={business.social.facebook.url} target="_blank" rel="noopener">
                <Icon name="facebook" size={20} /> Facebook <span class="visit-card__handle">{business.social.facebook.handle}</span>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
            <li>
              <a href={business.social.instagram.url} target="_blank" rel="noopener">
                <Icon name="instagram" size={20} /> Instagram <span class="visit-card__handle">{business.social.instagram.handle}</span>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
          </ul>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .visit {
    padding-block: var(--section-y);
    background: var(--cream);
  }
  .visit__inner {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .visit__main {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .visit__title {
    font-size: clamp(3rem, 1.6rem + 4.4vw, 6.6rem);
    line-height: 0.88;
  }
  .visit__title span {
    color: var(--red);
  }
  .visit__address {
    font-style: normal;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.3rem);
    line-height: 1.18;
  }
  .visit__eircode {
    color: var(--red);
  }
  .visit__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .visit__actions :global(.visit__phone-icon) {
    color: var(--red);
  }
  @media (hover: hover) {
    .visit__actions .btn:not(.btn--red):hover :global(.visit__phone-icon) {
      color: #fff;
    }
  }
  .visit__check {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--muted);
  }

  .visit__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .visit-card__body {
    display: grid;
    align-content: start;
    gap: 8px;
    height: 100%;
    padding: 24px;
    border-radius: var(--radius-l);
    background: var(--paper);
    box-shadow: var(--shadow-1);
  }
  .visit-card :global(.visit-card__icon) {
    color: var(--red);
    margin-bottom: 6px;
  }
  .visit-card__title {
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green);
  }
  .visit-card__big {
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.8rem);
    line-height: 1;
    text-decoration: none;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  a.visit-card__big:hover {
    color: var(--red);
  }
  .visit-card__meta {
    font-size: 0.84rem;
    color: var(--muted);
  }
  .visit-card__text {
    font-size: 1.05rem;
  }
  .visit-card__text a {
    font-weight: 700;
    white-space: nowrap;
  }
  .visit-card__hours div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 4px;
    border-bottom: 1px solid var(--line);
  }
  .visit-card__hours dd {
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  .visit-card--phone .visit-card__body {
    background: var(--red);
    color: #fff;
  }
  .visit-card--phone :global(.visit-card__icon),
  .visit-card--phone .visit-card__title,
  .visit-card--phone .visit-card__big,
  .visit-card--phone .visit-card__meta {
    color: #fff;
  }
  .visit-card--phone a.visit-card__big:hover {
    color: var(--glow);
  }
  .visit-card--phone :focus-visible {
    outline-color: #fff;
  }
  .visit-card--eircode .visit-card__body {
    background: var(--green);
    color: #fff;
  }
  .visit-card--eircode :global(.visit-card__icon) {
    color: #ffb3b9;
  }
  .visit-card--eircode .visit-card__title {
    color: #a8e0c2;
  }
  .visit-card--eircode .visit-card__big {
    color: #fff;
  }
  .visit-card__social {
    display: grid;
    gap: 6px;
  }
  .visit-card__social a {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    min-height: 44px;
    font-weight: 650;
    text-decoration: none;
  }
  .visit-card__social a:hover {
    color: var(--red);
  }
  .visit-card__handle {
    font-weight: 450;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .visit__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .visit__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
