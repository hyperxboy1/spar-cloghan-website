---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { business, addressOneLine } from '../data/business';
import { IS_REVIEW } from '../data/site';
import { allImages } from '../data/images';

const anyPlaceholder = Object.values(allImages).some((img) => img.placeholder);
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark tone="dark" />
      <p class="site-footer__sign hand">Local heart. Big appetite.</p>
    </div>

    <ul class="site-footer__contact" role="list">
      <li>
        <Icon name="pin" size={20} />
        <address>{addressOneLine}</address>
      </li>
      <li>
        <Icon name="phone" size={20} />
        <a href={business.phone.href}>{business.phone.display}</a>
      </li>
    </ul>

    <div class="site-footer__social">
      <p>Follow us</p>
      <ul role="list">
        <li>
          <a href={business.social.facebook.url} target="_blank" rel="noopener">
            <Icon name="facebook" size={22} />
            <span class="visually-hidden">{business.social.facebook.label} (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a href={business.social.instagram.url} target="_blank" rel="noopener">
            <Icon name="instagram" size={22} />
            <span class="visually-hidden">{business.social.instagram.label} (opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="site-footer__legal">
    <p>© {year} {business.localName}, {business.address.town}. A SPAR Express store.</p>
    {
      anyPlaceholder && (
        <p>
          Food images on this page are temporary concept art from the design reference, not photographs of this shop or
          its products.
        </p>
      )
    }
    {IS_REVIEW && <p>Draft preview — not yet approved by the shop. Not indexed by search engines.</p>}
  </div>
</footer>

<style>
  .site-footer {
    background: var(--green-900);
    color: #e9f1ec;
  }
  .site-footer__inner {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
    padding-block: 48px 36px;
    display: grid;
    grid-template-columns: 1.2fr 1.4fr auto;
    gap: 32px;
    align-items: center;
  }
  .site-footer__sign {
    font-size: 1.7rem;
    color: #fff;
    margin-top: 6px;
    transform: rotate(-3deg);
    transform-origin: left;
  }
  .site-footer__contact {
    display: grid;
    gap: 10px;
  }
  .site-footer__contact li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .site-footer__contact :global(.icon) {
    color: #ff8a92;
    flex: none;
  }
  .site-footer address {
    font-style: normal;
  }
  .site-footer__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }
  .site-footer__contact a:hover {
    text-decoration: underline;
  }
  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .site-footer__social p {
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .site-footer__social ul {
    display: flex;
    gap: 8px;
  }
  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.35);
    transition: background-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out), transform var(--dur) var(--ease-pop);
  }
  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    background: #fff;
    color: var(--green-900);
    transform: translateY(-3px);
  }
  .site-footer__legal {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
    padding-block: 18px 28px;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    display: grid;
    gap: 4px;
    font-size: 0.8rem;
    color: rgb(233 241 236 / 0.78);
  }
  @media (max-width: 900px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
