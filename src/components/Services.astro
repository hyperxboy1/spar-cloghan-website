---
import Icon from './Icon.astro';
import Tbc from './Tbc.astro';
import { services } from '../data/services';
import { business } from '../data/business';
import { isShown, IS_REVIEW } from '../data/site';

const shown = services.filter((s) => isShown(s.status));
const anyUnconfirmed = shown.some((s) => s.status !== 'approved');
---

<section class="services on-dark" id="services" aria-labelledby="services-title">
  <div class="services__inner">
    <header class="services__head">
      <p class="kicker services__kicker">Forecourt & store</p>
      <h2 id="services-title" class="display services__title">Here when<br />you need us.</h2>
      <p class="services__intro">
        {
          shown.length
            ? 'The everyday essentials, all in one stop on Hill Street.'
            : 'Call the shop to check which services are available today.'
        }
      </p>
      <a class="btn btn--ghost-light btn--small services__call" href={business.phone.href}>
        <span class="btn__inner"><Icon name="phone" size={18} /> Check before you travel: {business.phone.display}</span>
      </a>
    </header>

    {
      shown.length > 0 && (
        <ul class="services__grid" role="list">
          {shown.map((s, i) => (
            <li class="pop service" style={`--i:${i}`}>
              <div class="pop__body service__body">
                <span class="service__icon">
                  <Icon name={s.icon} size={28} />
                </span>
                <h3 class="service__label">{s.label}</h3>
                <p class="service__detail">{s.detail}</p>
                <Tbc status={s.status} />
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  {
    IS_REVIEW && anyUnconfirmed && (
      <p class="services__note">
        Services marked “To confirm” are listed publicly by Maxol for this station and are awaiting the shop’s confirmation.
      </p>
    )
  }
</section>

<style>
  .services {
    position: relative;
    background:
      radial-gradient(80% 60% at 0% 100%, rgb(19 112 76 / 0.45), transparent 60%),
      var(--green);
    color: #fff;
    padding-block: var(--section-y);
    overflow: clip;
  }
  .services__inner {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .services__head {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .services__kicker {
    color: #a8e0c2;
  }
  .services__title {
    font-size: clamp(2.8rem, 1.6rem + 3.6vw, 5.6rem);
    line-height: 0.88;
  }
  .services__intro {
    font-size: var(--step-1);
    color: rgb(255 255 255 / 0.85);
    max-width: 34ch;
  }
  .services__call {
    margin-top: 6px;
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
    gap: 14px;
  }
  .service {
    outline: none;
  }
  .service__body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 6px;
    height: 100%;
    padding: 22px 20px 20px;
    border-radius: var(--radius-m);
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.16);
  }
  .service:hover .service__body {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 30px 50px -26px rgb(0 20 10 / 0.75);
  }
  .service__icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-bottom: 8px;
    border-radius: 50%;
    background: var(--paper);
    color: var(--green);
    transition: background-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out), transform 460ms var(--ease-pop);
  }
  .service:hover .service__icon {
    background: var(--red);
    color: #fff;
    transform: rotate(-8deg) scale(1.08);
  }
  .service__label {
    font-family: var(--font-serif);
    font-size: 1.22rem;
    line-height: 1.15;
  }
  .service__detail {
    font-size: 0.88rem;
    opacity: 0.8;
  }
  .service :global(.tbc) {
    margin-top: 6px;
  }
  .service:hover :global(.tbc) {
    color: #8a5a00;
    background: rgb(255 214 120 / 0.25);
  }
  .services__note {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin: 40px auto 0;
    font-size: 0.84rem;
    color: rgb(255 255 255 / 0.72);
  }
  @media (max-width: 960px) {
    .services__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .services__grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .service__body {
      padding: 16px 14px;
    }
    .service__label {
      font-size: 1.05rem;
    }
  }
</style>
