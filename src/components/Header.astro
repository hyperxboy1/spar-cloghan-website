---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { business } from '../data/business';
import { navLinks as links } from '../lib/sections';
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <Wordmark />

    <nav class="site-nav" aria-label="Main">
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="header-call" href={business.phone.href}>
        <Icon name="phone" size={18} />
        <span>{business.phone.display}</span>
      </a>
      <a class="btn btn--red btn--small header-visit" href="#visit">
        <span class="btn__inner">Visit us</span>
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-toggle__icon menu-toggle__icon--open"><Icon name="menu" /></span>
        <span class="menu-toggle__icon menu-toggle__icon--close"><Icon name="close" /></span>
        <span class="menu-toggle__label">Menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu. Without JavaScript these links are shown as a simple row instead. -->
  <nav id="mobile-menu" class="mobile-menu" aria-label="Main (mobile)" data-menu>
    <ul role="list">
      {
        links.map((l) => (
          <li>
            <a href={l.href}>
              {l.label}
              <Icon name="arrow" size={20} />
            </a>
          </li>
        ))
      }
      <li>
        <a href="#visit">
          Visit us
          <Icon name="arrow" size={20} />
        </a>
      </li>
    </ul>
    <p class="mobile-menu__call">
      <a href={business.phone.href}><Icon name="phone" size={18} /> Call {business.phone.display}</a>
    </p>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(255 250 241 / 0.94);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 48px);
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    gap: clamp(6px, 1.4vw, 22px);
  }
  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 6px;
    font-size: 0.95rem;
    font-weight: 560;
    text-decoration: none;
    color: var(--ink-2);
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 8px;
    height: 2px;
    border-radius: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }
  .site-nav a:hover::after,
  .site-nav a:focus-visible::after {
    transform: scaleX(1);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .header-call {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .header-call .icon {
    color: var(--red);
  }

  /* Menu toggle */
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--line);
    background: var(--paper);
    font-weight: 650;
    cursor: pointer;
  }
  .menu-toggle__icon--close,
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--close {
    display: inline-flex;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 1100px) {
    .header-call span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .header-call {
      width: 44px;
      justify-content: center;
      border-radius: 50%;
      box-shadow: inset 0 0 0 1.5px var(--line);
    }
  }

  @media (max-width: 400px) {
    .menu-toggle {
      padding: 0 12px;
    }
    .menu-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
  @media (max-width: 860px) {
    .site-nav,
    .header-visit {
      display: none;
    }
    .site-header__actions {
      margin-left: auto;
      gap: 8px;
    }
    /* The dock already offers "Call the shop" on small screens. */
    .header-call {
      display: none;
    }
    /* JS enhanced: toggleable panel */
    :global(.js) .menu-toggle {
      display: inline-flex;
    }
    :global(.js) .mobile-menu {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 30px 40px -30px rgb(40 20 10 / 0.4);
      padding: 8px var(--gutter) 20px;
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
    }
    :global(.js) .mobile-menu.is-open {
      display: block;
    }
    .mobile-menu ul {
      display: grid;
    }
    .mobile-menu li + li {
      border-top: 1px solid var(--line);
    }
    .mobile-menu a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 56px;
      font-family: var(--font-display);
      text-transform: uppercase;
      font-size: 1.6rem;
      letter-spacing: 0.01em;
      text-decoration: none;
    }
    .mobile-menu a .icon {
      color: var(--red);
    }
    .mobile-menu__call a {
      font-family: var(--font-sans);
      text-transform: none;
      font-size: 1rem;
      font-weight: 650;
      justify-content: center;
      gap: 10px;
      margin-top: 8px;
      border-radius: var(--radius-pill);
      background: var(--red);
      color: #fff;
    }
    .mobile-menu__call a .icon {
      color: #fff;
    }
    /* No JS: links are always visible as a compact scrollable row */
    :global(.no-js) .mobile-menu {
      display: block;
      overflow-x: auto;
      padding: 0 var(--gutter) 8px;
    }
    :global(.no-js) .mobile-menu ul {
      display: flex;
      gap: 6px;
    }
    :global(.no-js) .mobile-menu li + li {
      border: 0;
    }
    :global(.no-js) .mobile-menu a {
      font-family: var(--font-sans);
      text-transform: none;
      font-size: 0.92rem;
      font-weight: 600;
      min-height: 44px;
      padding: 0 14px;
      gap: 6px;
      border-radius: var(--radius-pill);
      box-shadow: inset 0 0 0 1.5px var(--line);
      white-space: nowrap;
    }
    :global(.no-js) .mobile-menu a .icon,
    :global(.no-js) .mobile-menu__call {
      display: none;
    }
  }
</style>
