---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { business } from '../data/business';
import { useImage } from '../data/images';
import { motion } from '../data/site';
import { exploreHref } from '../lib/sections';

const baguette = useImage('baguette');
const latte = useImage('latte');
const deli = useImage('deliSandwich');
const d = motion.heroDepth;
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <!-- Background plane: moves opposite the pointer. Oversized so edges never show. -->
  <div class="hero__layer hero__bg" data-layer data-depth={d.background} data-spring="bg" aria-hidden="true">
    <div class="hero__enter hero__enter--disc"><div class="hero__disc"></div></div>
    <div class="hero__ring"></div>
    <div class="hero__dots"></div>
    <div class="hero__fields"></div>
  </div>

  <div class="hero__grid">
    <div class="hero__copy">
      <p class="hero__kicker kicker">
        <span>{business.localName}</span>
        <span class="hero__kicker-dot" aria-hidden="true"></span>
        <span>{business.address.town}</span>
      </p>

      <h2 id="hero-title" class="hero__title display">
        <span class="hero__line">Local heart.</span>
        <span class="hero__line hero__line--red">Big appetite.</span>
      </h2>

      <p class="hero__lede serif">Your local SPAR in Cloghan, Co.&nbsp;Offaly.</p>

      <div class="hero__actions">
        <a class="btn btn--red btn--lg" href={exploreHref} data-magnetic>
          <span class="btn__inner">
            Explore the store
            <span class="btn__arrow"><Icon name="arrow" size={20} /></span>
          </span>
        </a>
        <a class="btn btn--lg" href={business.directionsUrl} target="_blank" rel="noopener" data-magnetic>
          <span class="btn__inner">
            <Icon name="pin" size={20} class="btn__pin" />
            Get directions
            <span class="visually-hidden">(opens Google Maps in a new tab)</span>
          </span>
        </a>
      </div>

      <p class="hero__where">
        <Icon name="pin" size={18} />
        <span>{business.address.street}, {business.address.town} · {business.address.eircode}</span>
        <span class="hero__where-sep" aria-hidden="true"></span>
        <a href={business.phone.href}>
          <Icon name="phone" size={17} />
          <span>{business.phone.display}</span>
        </a>
      </p>
    </div>

    <div class="hero__stage" data-stage>
      <div class="hero__layer hero__ghost" data-layer data-depth={d.ghostType} data-spring="bg" aria-hidden="true">
        <span class="hero__enter hero__enter--label">Cloghan</span>
      </div>

      <div class="hero__layer hero__plane hero__plane--deli" data-layer data-depth={d.midgroundAlt} data-rot="-1" data-spring="mid">
        <div class="hero__enter hero__enter--plane2">
          <figure class="hero__frame">
            <Picture
              src={deli.src}
              alt={deli.alt}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[240, 360, 520]}
              sizes="(max-width: 860px) 0px, 16vw"
              quality={68}
              loading="eager"
              decoding="async"
              style={`object-position:${deli.focal.desktop}`}
            />
          </figure>
        </div>
      </div>

      <div class="hero__layer hero__plane hero__plane--latte" data-layer data-depth={d.midground} data-rot="1.2" data-spring="mid">
        <div class="hero__enter hero__enter--plane">
          <figure class="hero__frame">
            <Picture
              src={latte.src}
              alt={latte.alt}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[300, 440, 600]}
              sizes="(max-width: 860px) 40vw, 20vw"
              quality={68}
              loading="eager"
              decoding="async"
              style={`object-position:${latte.focal.desktop}`}
            />
            <span class="hero__sheen" data-sheen aria-hidden="true"></span>
          </figure>
          <svg class="hero__badge" viewBox="0 0 120 120" aria-hidden="true">
            <defs><path id="badge-circle" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0"></path></defs>
            <circle cx="60" cy="60" r="58" fill="var(--green)"></circle>
            <text><textPath href="#badge-circle" startOffset="0">HILL STREET • CLOGHAN • CO. OFFALY •</textPath></text>
            <path d="M60 78s-13-8-13-17.5a7.5 7.5 0 0 1 13-5 7.5 7.5 0 0 1 13 5C73 70 60 78 60 78z" fill="var(--red)"></path>
          </svg>
        </div>
      </div>

      <div class="hero__layer hero__note" data-layer data-depth={d.note} data-spring="mid" aria-hidden="true">
        <span class="hero__enter hero__enter--label hand">Pop in on<br />Hill Street</span>
        <svg class="hero__note-arrow hero__enter hero__enter--label" viewBox="0 0 120 80" fill="none">
          <path d="M6 10c30-6 62 4 78 30 6 10 9 20 10 30" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
          <path d="M82 60l12 12 10-16" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>

      <div class="hero__layer hero__fg" data-layer data-depth={d.foreground} data-rot={motion.foregroundRotation} data-spring="fg">
        <div class="hero__enter hero__enter--fg">
          <div class="hero__fg-art">
            <span class="hero__fg-shadow" aria-hidden="true"></span>
            <Picture
              src={baguette.src}
              alt={baguette.alt}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[420, 560, 760, 900, 1200, 1600]}
              sizes="(max-width: 860px) 104vw, 46vw"
              quality={74}
              loading="eager"
              decoding="async"
              class="hero__fg-img"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pointer-driven light: a bounded, pre-rendered gradient that is only translated. -->
  <div class="hero__spot" data-spot aria-hidden="true"></div>
  <div class="hero__accent" data-accent aria-hidden="true"></div>
</section>

<style>
  .hero {
    --stage-pad: clamp(16px, 3vw, 40px);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 0% 0%, #fff8ec 0%, transparent 55%),
      linear-gradient(180deg, var(--cream) 0%, #f5ead6 100%);
    min-height: clamp(620px, calc(100svh - var(--header-h)), 900px);
  }
  :global(.is-review) .hero {
    min-height: clamp(600px, calc(100svh - var(--header-h) - 34px), 880px);
  }

  /* Layers: positioned boxes. The pointer controller writes `transform` on .hero__layer,
     the entrance animates .hero__enter, and resting pose / hover live on inner elements. */
  .hero__layer {
    position: absolute;
  }

  /* ---------- Background ---------- */
  .hero__bg {
    inset: -40px;
    z-index: 0;
    pointer-events: none;
  }
  .hero__enter--disc {
    position: absolute;
    right: calc(40px + 3vw);
    top: 50%;
    width: clamp(480px, 47vw, 760px);
    aspect-ratio: 1;
    margin-top: calc(clamp(480px, 47vw, 760px) / -2 + 10px);
  }
  .hero__disc {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, rgb(255 120 110 / 0.55), transparent 42%),
      radial-gradient(circle at 50% 50%, #d5182f 0%, var(--red) 58%, var(--red-700) 100%);
    box-shadow:
      inset -30px -40px 80px rgb(80 0 10 / 0.35),
      0 40px 80px -40px rgb(120 10 20 / 0.6);
  }
  .hero__ring {
    position: absolute;
    left: 52%;
    top: calc(40px + 4%);
    width: clamp(160px, 15vw, 240px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid var(--green);
    opacity: 0.55;
  }
  .hero__dots {
    position: absolute;
    right: calc(40px + 1.5vw);
    top: calc(40px + 4%);
    width: 150px;
    height: 110px;
    background-image: radial-gradient(circle, var(--green) 1.6px, transparent 2px);
    background-size: 15px 15px;
    opacity: 0.45;
  }
  .hero__fields {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: 0;
    height: 120px;
    background:
      radial-gradient(60% 120px at 20% 100%, rgb(12 74 51 / 0.1), transparent 70%),
      radial-gradient(50% 90px at 75% 100%, rgb(12 74 51 / 0.08), transparent 70%);
  }

  /* ---------- Copy ---------- */
  .hero__grid {
    position: relative;
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
    min-height: inherit;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
  }
  .hero__copy {
    position: relative;
    z-index: 6;
    padding-block: clamp(40px, 6vh, 80px);
  }
  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(14px, 2.2vh, 24px);
    color: var(--green);
  }
  .hero__kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
  }
  .hero__title {
    font-size: clamp(3.6rem, 9.1vw, 8.6rem);
    line-height: 0.88;
    letter-spacing: -0.004em;
    color: var(--ink);
  }
  .hero__line {
    display: block;
    white-space: nowrap;
  }
  .hero__line--red {
    color: var(--red);
  }
  .hero__lede {
    margin-top: clamp(16px, 2.6vh, 28px);
    font-size: clamp(1.3rem, 1rem + 1vw, 2rem);
    line-height: 1.2;
    color: var(--ink);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(24px, 4vh, 40px);
  }
  .hero__actions :global(.btn__pin) {
    color: var(--red);
  }
  @media (hover: hover) {
    .hero__actions .btn:not(.btn--red):hover :global(.btn__pin) {
      color: #fff;
    }
  }
  .hero__where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-top: clamp(20px, 3.4vh, 34px);
    font-size: 0.94rem;
    color: var(--muted);
  }
  .hero__where > :global(.icon) {
    color: var(--red);
  }
  .hero__where-sep {
    width: 1px;
    height: 18px;
    background: var(--line);
    margin-inline: 4px;
  }
  .hero__where a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .hero__where a :global(.icon) {
    color: var(--red);
  }
  .hero__where a:hover span {
    text-decoration: underline;
  }

  /* ---------- Stage ---------- */
  .hero__stage {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    right: calc(-1 * var(--gutter));
    width: 56%;
  }
  .hero__ghost {
    z-index: 1;
    left: -2%;
    right: -12%;
    bottom: 3.5%;
    pointer-events: none;
  }
  .hero__ghost span {
    display: block;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(6rem, 12.4vw, 12.5rem);
    line-height: 0.8;
    letter-spacing: 0.01em;
    color: transparent;
    -webkit-text-stroke: 2px rgb(120 10 25 / 0.28);
    mix-blend-mode: multiply;
    white-space: nowrap;
  }

  .hero__plane {
    z-index: 3;
  }
  .hero__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--cream-3);
    box-shadow: var(--shadow-2), 0 0 0 6px var(--paper);
    transition: transform 520ms var(--ease-out), box-shadow 520ms var(--ease-out);
  }
  .hero__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }
  .hero__plane--latte {
    top: 9%;
    right: 9%;
    width: clamp(200px, 19vw, 290px);
  }
  .hero__plane--latte .hero__frame {
    aspect-ratio: 0.9;
    transform: rotate(5deg);
  }
  .hero__plane--deli {
    top: 15%;
    left: 6%;
    width: clamp(160px, 14.5vw, 220px);
    z-index: 2;
  }
  .hero__plane--deli .hero__frame {
    aspect-ratio: 0.88;
    transform: rotate(-7deg);
  }
  @media (hover: hover) {
    .hero__plane--latte:hover .hero__frame {
      transform: rotate(4deg) scale(1.03);
      box-shadow: var(--shadow-pop), 0 0 0 6px var(--paper);
    }
    .hero__plane--deli:hover .hero__frame {
      transform: rotate(-6deg) scale(1.03);
      box-shadow: var(--shadow-pop), 0 0 0 6px var(--paper);
    }
    .hero__plane:hover .hero__frame :global(img) {
      transform: scale(1.03);
    }
  }
  .hero__sheen {
    position: absolute;
    inset: -10% -60%;
    background: linear-gradient(100deg, transparent 38%, rgb(255 255 255 / 0.42) 50%, transparent 62%);
    mix-blend-mode: soft-light;
    transform: translate3d(-22%, 0, 0);
    pointer-events: none;
  }
  .hero__badge {
    position: absolute;
    width: 104px;
    height: 104px;
    left: -44px;
    top: -34px;
    transform: rotate(-12deg);
    filter: drop-shadow(0 10px 14px rgb(10 40 25 / 0.35));
  }
  .hero__badge text {
    font-family: var(--font-sans);
    font-size: 10.2px;
    font-weight: 700;
    letter-spacing: 1.6px;
    fill: #fff;
  }

  .hero__note {
    z-index: 4;
    top: 21%;
    left: 35%;
    color: var(--ink);
    pointer-events: none;
  }
  .hero__note .hand {
    display: block;
    font-size: clamp(1.5rem, 1.1rem + 0.9vw, 2.1rem);
    line-height: 0.95;
    transform: rotate(-8deg);
  }
  .hero__note-arrow {
    width: 84px;
    margin: 6px 0 0 36px;
    color: var(--red);
    transform: rotate(-4deg);
  }

  .hero__fg {
    z-index: 5;
    left: 4%;
    right: 9%;
    bottom: 9%;
    pointer-events: none;
  }
  .hero__fg-art {
    position: relative;
    transform: rotate(-4deg);
    transform-origin: 50% 60%;
  }
  .hero__fg-art :global(img) {
    width: 100%;
    filter: drop-shadow(0 26px 22px rgb(70 18 8 / 0.32)) drop-shadow(0 4px 6px rgb(70 18 8 / 0.18));
  }
  .hero__fg-shadow {
    position: absolute;
    left: 10%;
    right: 6%;
    bottom: -4%;
    height: 24%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(60 14 6 / 0.36), transparent);
  }

  /* ---------- Light & cursor accent ---------- */
  .hero__spot {
    --size: 620px;
    position: absolute;
    z-index: 5;
    left: 0;
    top: 0;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 236 170 / 0.62), rgb(255 226 150 / 0.24) 48%, rgb(255 226 150 / 0) 100%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms var(--ease-out);
  }
  .hero__accent {
    position: absolute;
    z-index: 8;
    left: 0;
    top: 0;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 226 140 / 0.55), rgb(255 226 140 / 0.18) 70%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease-out);
  }
  .hero__accent::after {
    content: '';
    position: absolute;
    inset: 16px;
    border-radius: 50%;
    border: 1.5px solid rgb(200 16 46 / 0.75);
    transition: transform 300ms var(--ease-out), border-color 300ms var(--ease-out);
  }
  .hero.is-lit .hero__spot {
    opacity: 1;
  }
  .hero.is-lit .hero__accent {
    opacity: 1;
  }
  .hero.is-over-control .hero__accent {
    opacity: 0;
  }

  /* ---------- Entrance (CSS, runs on first paint, no JS needed) ----------
     Headline and navigation are visible on the first frame; only transforms settle. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__line {
      animation: hero-settle 820ms var(--ease-out) both;
    }
    .hero__line--red {
      animation-delay: 70ms;
    }
    .hero__enter--disc {
      animation: hero-disc 980ms var(--ease-out) both;
    }
    .hero__enter--fg {
      animation: hero-fly-fg 940ms var(--ease-out) 110ms both;
    }
    .hero__enter--plane {
      animation: hero-fly-plane 860ms var(--ease-out) 200ms both;
    }
    .hero__enter--plane2 {
      animation: hero-fly-plane2 860ms var(--ease-out) 260ms both;
    }
    .hero__enter--label {
      animation: hero-fade 520ms var(--ease-out) 560ms both;
    }
    .hero__lede,
    .hero__actions,
    .hero__where {
      animation: hero-rise 700ms var(--ease-out) both;
    }
    .hero__actions {
      animation-delay: 60ms;
    }
    .hero__where {
      animation-delay: 120ms;
    }
  }
  .hero__enter {
    display: block;
  }

  @keyframes hero-settle {
    from {
      transform: translate3d(0, 0.16em, 0);
    }
  }
  @keyframes hero-rise {
    from {
      transform: translate3d(0, 14px, 0);
    }
  }
  @keyframes hero-disc {
    from {
      transform: scale(0.82) rotate(-12deg);
    }
  }
  @keyframes hero-fly-fg {
    from {
      opacity: 0;
      transform: translate3d(12%, 16%, 0) rotate(9deg) scale(0.9);
    }
  }
  @keyframes hero-fly-plane {
    from {
      opacity: 0;
      transform: translate3d(30px, -36px, 0) rotate(10deg) scale(0.9);
    }
  }
  @keyframes hero-fly-plane2 {
    from {
      opacity: 0;
      transform: translate3d(-30px, 40px, 0) rotate(-10deg) scale(0.9);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translate3d(0, 8px, 0);
    }
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1100px) and (min-width: 861px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
    .hero__title {
      font-size: clamp(3.4rem, 8.6vw, 6rem);
    }
    .hero__stage {
      width: 58%;
    }
    .hero__plane--deli {
      display: none;
    }
    .hero__note {
      top: 18%;
      left: 2%;
    }
  }

  /* ---------- Mobile: a separate composition, not a shrunken desktop ---------- */
  @media (max-width: 860px) {
    .hero {
      min-height: 0;
    }
    :global(.is-review) .hero {
      min-height: 0;
    }
    .hero__grid {
      display: block;
      min-height: 0;
    }
    .hero__copy {
      padding-block: 28px 0;
    }
    .hero__kicker {
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      margin-bottom: 14px;
    }
    .hero__title {
      font-size: clamp(3.3rem, 17.2vw, 6.4rem);
      line-height: 0.9;
    }
    .hero__lede {
      font-size: clamp(1.15rem, 4.8vw, 1.5rem);
      margin-top: 14px;
    }
    .hero__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 22px;
    }
    .btn--lg {
      min-height: 52px;
    }
    .btn--lg .btn__inner {
      padding: 14px 12px;
      font-size: 0.98rem;
      gap: 8px;
    }
    .hero__where {
      margin-top: 4px;
      font-size: 0.86rem;
    }
    .hero__where-sep,
    .hero__where a {
      display: none;
    }

    .hero__stage {
      position: relative;
      right: auto;
      width: auto;
      height: clamp(290px, 86vw, 560px);
      margin-inline: calc(-1 * var(--gutter));
      margin-top: 26px;
    }
    .hero__enter--disc {
      right: auto;
      left: 50%;
      top: auto;
      bottom: calc(40px - min(6vw, 30px));
      width: min(96vw, 560px);
      margin: 0 0 0 calc(min(96vw, 560px) * -0.42);
    }
    .hero__ring {
      left: auto;
      right: calc(40px + 4vw);
      top: auto;
      bottom: calc(40px + min(70vw, 440px));
      width: min(26vw, 180px);
    }
    .hero__dots {
      right: auto;
      top: auto;
      left: calc(40px + 2vw);
      bottom: calc(40px + 4vw);
      width: 90px;
      height: 70px;
    }
    .hero__ghost {
      display: none;
    }
    .hero__plane--deli {
      display: none;
    }
    .hero__plane--latte {
      top: 4%;
      right: 6%;
      width: 34vw;
    }
    .hero__badge {
      width: 66px;
      height: 66px;
      left: -28px;
      top: -20px;
    }
    .hero__badge text {
      font-size: 10.6px;
    }
    .hero__note {
      top: 10%;
      left: 5%;
    }
    .hero__note .hand {
      font-size: 1.5rem;
    }
    .hero__note-arrow {
      width: 62px;
      margin-left: 26px;
    }
    .hero__fg {
      left: -3%;
      right: 1%;
      bottom: 4%;
    }
    .hero__fg-art {
      transform: rotate(-5deg);
    }
    .hero__spot,
    .hero__accent {
      display: none;
    }
  }

  @media (min-width: 600px) and (max-width: 860px) {
    .hero__stage {
      height: clamp(420px, 70vw, 560px);
    }
    .hero__fg {
      left: 8%;
      right: 8%;
    }
    .hero__plane--latte {
      width: min(30vw, 240px);
      right: 10%;
    }
  }
  @media (max-width: 360px) {
    .hero__actions {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 400px) {
    .hero__actions .btn__arrow,
    .hero__actions :global(.btn__pin) {
      display: none;
    }
    .btn--lg .btn__inner {
      padding-inline: 10px;
