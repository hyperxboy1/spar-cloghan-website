---
/**
 * Food menu: a 2×2 grid of category tiles, each linking to a clean menu section on the page.
 * Content lives in src/data/menu.ts.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Tbc from './Tbc.astro';
import { menu, dinnerDeals } from '../data/menu';
import { business } from '../data/business';
import { isShown } from '../data/site';

const categories = menu.map((c) => ({ ...c, items: c.items.filter((i) => isShown(i.status)) }));
---

<section class="fm" id="menu" aria-labelledby="fm-title">
  <div class="fm__inner">
    <header class="fm__head">
      <p class="kicker">Deli & food</p>
      <h2 id="fm-title" class="display fm__title">What’s at the Counter</h2>
    </header>

    <ul class="fm__grid" role="list">
      {
        categories.map((c, i) => (
          <li>
            <a class="fm-tile" href={`#menu-${c.id}`}>
              <Image
                src={c.image}
                alt=""
                widths={[480, 720, 960]}
                sizes="(max-width: 700px) 100vw, 50vw"
                quality={74}
                loading={i < 2 ? 'eager' : 'lazy'}
                class="fm-tile__img"
                style={`object-position:${c.focal}`}
              />
              <span class="fm-tile__text">
                <span class="fm-tile__label">{c.label}</span>
                <span class="fm-tile__line">{c.line}</span>
              </span>
              <span class="fm-tile__arrow" aria-hidden="true">
                <Icon name="arrow-down" size={22} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {
    categories.map((c, i) => (
      <article class:list={['fm-cat', { 'fm-cat--flip': i % 2 === 1 }]} id={`menu-${c.id}`} aria-labelledby={`menu-${c.id}-title`}>
        <div class="fm-cat__media">
          <Image src={c.image} alt={c.imageAlt} widths={[480, 720, 960]} sizes="(max-width: 860px) 100vw, 45vw" quality={76} loading="lazy" style={`object-position:${c.focal}`} />
        </div>
        <div class="fm-cat__body">
          <h3 id={`menu-${c.id}-title`} class="display fm-cat__title">{c.label}</h3>
          <p class="fm-cat__intro">{c.intro}</p>

          {c.id === 'dinner' && (
            <div class="fm-deal" role="group" aria-label="Dinner prices">
              {dinnerDeals.map((d) => (
                <div class="fm-deal__item">
                  <span class="fm-deal__label">{d.label}</span>
                  <span class="fm-deal__was">
                    Were <s>{d.was}</s>
                  </span>
                  <span class="fm-deal__now">
                    <small>Now</small> {d.now}
                  </span>
                </div>
              ))}
            </div>
          )}

          <ul class="fm-list" role="list">
            {c.items.map((item) => (
              <li class="fm-list__row">
                <span class="fm-list__name">
                  {item.name} <Tbc status={item.status} />
                  {item.note && <small>{item.note}</small>}
                </span>
                <span class:list={['fm-list__price', { 'fm-list__price--ask': !item.price }]}>{item.price ?? 'Ask in store'}</span>
              </li>
            ))}
          </ul>

          <div class="fm-cat__actions">
            <a class="fm-call" href={business.phone.href}>
              <span class="fm-call__icon"><Icon name="phone" size={24} /></span>
              <span class="fm-call__text">
                <span>{c.callLabel}</span>
                <strong>{business.phone.display}</strong>
              </span>
            </a>
            {c.id === 'catering' && (
              <a class="fm-ask" href={business.social.facebook.url} target="_blank" rel="noopener">
                <Icon name="message" size={20} /> Ask about catering
                <span class="visually-hidden">(opens Facebook in a new tab)</span>
              </a>
            )}
          </div>
          <a class="fm-back" href="#menu">
            ↑ All food categories
          </a>
        </div>
      </article>
    ))
  }
</section>

<style>
  .fm {
    padding-block: var(--section-y) calc(var(--section-y) * 0.5);
    background: var(--cream);
  }
  .fm__inner,
  .fm-cat {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
  }
  .fm__head {
    display: grid;
    gap: 10px;
    margin-bottom: clamp(24px, 3.5vw, 44px);
  }
  .fm__title {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 5.4rem);
    text-wrap: balance;
  }

  /* ---------- 2×2 category grid ---------- */
  .fm__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 22px);
    margin: 0;
  }
  .fm-tile {
    position: relative;
    display: block;
    height: clamp(240px, 28vw, 420px);
    border-radius: 22px;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: var(--ink);
    box-shadow: var(--shadow-2);
    isolation: isolate;
    transition: transform 420ms var(--ease-out), box-shadow 420ms var(--ease-out);
  }
  .fm-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 40%, rgb(10 6 4 / 0.78) 100%);
    transition: opacity 420ms var(--ease-out);
  }
  .fm-tile :global(.fm-tile__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    transition: transform 900ms var(--ease-out);
  }
  .fm-tile__text {
    position: absolute;
    z-index: 1;
    left: clamp(20px, 2.6vw, 36px);
    right: 96px;
    bottom: clamp(18px, 2.4vw, 32px);
    display: grid;
    gap: 6px;
  }
  .fm-tile__label {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.6rem);
    line-height: 0.92;
    text-shadow: 0 2px 16px rgb(0 0 0 / 0.4);
  }
  .fm-tile__line {
    font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.15rem);
    font-weight: 550;
    opacity: 0.95;
  }
  .fm-tile__arrow {
    position: absolute;
    z-index: 1;
    right: clamp(18px, 2.4vw, 32px);
    bottom: clamp(18px, 2.4vw, 32px);
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    color: var(--red);
    transition: transform 420ms var(--ease-pop), background-color 300ms, color 300ms;
  }
  .fm-tile:is(:hover, :focus-visible) {
    transform: translateY(-6px);
    box-shadow: var(--shadow-pop);
  }
  .fm-tile:is(:hover, :focus-visible) :global(.fm-tile__img) {
    transform: scale(1.05);
  }
  .fm-tile:is(:hover, :focus-visible) .fm-tile__arrow {
    background: var(--red);
    color: #fff;
    transform: translateY(4px);
  }

  /* ---------- Category sections ---------- */
  .fm-cat {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(56px, 7vw, 104px) 0;
    scroll-margin-top: calc(var(--header-h) + 12px);
  }
  .fm-cat--flip .fm-cat__media {
    order: 2;
  }
  .fm-cat__media {
    border-radius: 26px;
    overflow: hidden;
    aspect-ratio: 4 / 4.2;
    box-shadow: var(--shadow-2);
  }
  .fm-cat__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fm-cat__body {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .fm-cat__title {
    font-size: clamp(2.6rem, 1.4rem + 3.6vw, 4.6rem);
    line-height: 0.9;
    color: var(--ink);
    text-wrap: balance;
  }
  .fm-cat__intro {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 44ch;
  }

  /* Dinner offer block */
  .fm-deal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    border-radius: 18px;
    overflow: hidden;
    background: var(--red-700);
    box-shadow: 0 20px 40px -24px rgb(120 10 20 / 0.7);
  }
  .fm-deal__item {
    display: grid;
    justify-items: start;
    gap: 2px;
    padding: 18px 22px 20px;
    background: var(--red);
    color: #fff;
  }
  .fm-deal__label {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .fm-deal__was {
    font-size: 1.05rem;
    opacity: 0.9;
  }
  .fm-deal__was s {
    font-weight: 700;
    text-decoration-thickness: 2px;
  }
  .fm-deal__now {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 3vw, 4.6rem);
    line-height: 0.95;
    color: #ffe500;
  }
  .fm-deal__now small {
    font-size: 0.42em;
    color: #fff;
    vertical-align: 0.9em;
    margin-right: 4px;
  }

  /* Menu list */
  .fm-list {
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  .fm-list__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 2px;
    border-bottom: 1px solid var(--line);
  }
  .fm-list__name {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.2;
    min-width: 0;
  }
  .fm-list__name small {
    display: block;
    margin-top: 3px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .fm-list__name :global(.tbc) {
    margin-left: 6px;
  }
  .fm-list__price {
    flex: none;
    font-weight: 800;
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }
  .fm-list__price--ask {
    font-weight: 600;
    font-size: 0.86rem;
    color: var(--muted);
  }

  /* Phone buttons */
  .fm-cat__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 6px;
  }
  .fm-call {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 68px;
    padding: 10px 28px 10px 12px;
    border-radius: var(--radius-pill);
    background: var(--red);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 14px 28px -14px rgb(150 10 25 / 0.8);
    transition: transform 300ms var(--ease-out), background-color 300ms var(--ease-out);
  }
  .fm-call:hover {
    background: var(--red-700);
    transform: translateY(-2px);
  }
  .fm-call__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #fff;
    color: var(--red);
  }
  .fm-call__text {
    display: grid;
    line-height: 1.15;
  }
  .fm-call__text span {
    font-size: 0.92rem;
    font-weight: 600;
  }
  .fm-call__text strong {
    font-size: 1.4rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .fm-ask {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 56px;
    padding: 0 22px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 2px var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .fm-ask:hover {
    background: var(--ink);
    color: #fff;
  }
  .fm-back {
    justify-self: start;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .fm-cat {
      grid-template-columns: 1fr;
    }
    .fm-cat--flip .fm-cat__media {
      order: 0;
    }
    .fm-cat__media {
      aspect-ratio: 16 / 10;
    }
    .fm-call {
      width: 100%;
    }
  }
  @media (max-width: 700px) {
    .fm__grid {
      grid-template-columns: 1fr;
    }
    .fm-tile {
      height: clamp(200px, 56vw, 320px);
    }
    .fm-ask {
      width: 100%;
      justify-content: center;
    }
  }
  @media (max-width: 420px) {
    .fm-deal {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fm-tile:is(:hover, :focus-visible),
    .fm-tile:is(:hover, :focus-visible) :global(.fm-tile__img) {
      transform: none;
    }
  }
</style>
