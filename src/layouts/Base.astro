---
import '../styles/global.css';
import antonUrl from '../assets/fonts/anton-latin-400-normal.woff2?url';
import { meta, ALLOW_INDEXING, SITE_URL, IS_REVIEW } from '../data/site';
import { business } from '../data/business';
import { hours } from '../data/hours';
import PreviewBanner from '../components/PreviewBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileDock from '../components/MobileDock.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title = meta.title, description = meta.description } = Astro.props;

/*
 * Structured data is emitted ONLY from manager-approved facts. While the core
 * business details are still 'review', nothing is emitted. Opening hours are added
 * only once approved. No ratings, reviews or invented attributes.
 */
const structuredData =
  business.status === 'approved'
    ? {
        '@context': 'https://schema.org',
        '@type': 'ConvenienceStore',
        name: business.name,
        alternateName: business.localName,
        telephone: business.phone.international,
        address: {
          '@type': 'PostalAddress',
          streetAddress: business.address.street,
          addressLocality: business.address.town,
          addressRegion: business.address.countyLong,
          postalCode: business.address.eircode,
          addressCountry: business.address.countryCode,
        },
        sameAs: [business.social.facebook.url, business.social.instagram.url],
        ...(SITE_URL ? { url: SITE_URL } : {}),
        ...(hours.approved && hours.store.length
          ? {
              openingHoursSpecification: hours.store.map((row) => ({
                '@type': 'OpeningHoursSpecification',
                dayOfWeek: row.days.map((d) => `https://schema.org/${{ Mo: 'Monday', Tu: 'Tuesday', We: 'Wednesday', Th: 'Thursday', Fr: 'Friday', Sa: 'Saturday', Su: 'Sunday' }[d]}`),
                opens: row.opens,
                closes: row.closes,
              })),
            }
          : {}),
      }
    : null;

const canonical = SITE_URL ? new URL(Astro.url.pathname, SITE_URL).href : null;
---

<!doctype html>
<html lang="en-IE" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!ALLOW_INDEXING && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={meta.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Only the headline face is preloaded: it is the largest text on the first screen. -->
    <link rel="preload" href={antonUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class:list={[{ 'is-review': IS_REVIEW }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    {IS_REVIEW && <PreviewBanner />}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileDock />
    <script>
      import { boot } from '../scripts/main';
      boot();
    </script>
  </body>
</html>
